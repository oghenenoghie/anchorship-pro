# Neon pooled connection string for app traffic
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
# Optional direct/unpooled connection for migrations
DATABASE_URL_MIGRATIONS=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional transactional email integration (Resend-compatible REST API)
EMAIL_API_KEY=
EMAIL_FROM=Anchorship <website@anchorship.nl>
ENQUIRY_NOTIFICATION_EMAIL=info@anchorship.nl
# Optional S3-compatible/object storage provider; demo uses URL fields
IMAGE_STORAGE_URL=
IMAGE_STORAGE_TOKEN=
